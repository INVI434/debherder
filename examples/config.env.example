# Sample configuration for debherder.
# Copy to ~/.config/debherder/config.env and uncomment what you need.

# ---------------------------------------------------------------------------
# Architecture
# ---------------------------------------------------------------------------
# Target architecture. Defaults to `dpkg --print-architecture`.
# Set empty ("") to match any architecture.
# ARCH=amd64
#
# Common aliases are accepted in filenames automatically:
#   amd64  ~ x86_64 ~ x64
#   arm64  ~ aarch64
#   armhf  ~ armv7l ~ armv7
#   armel  ~ armv6l ~ armv6
#   i386   ~ i686   ~ x86

# ---------------------------------------------------------------------------
# Asset selection
# ---------------------------------------------------------------------------
# Extra substring filter on the .deb filename. Useful when a release ships
# multiple variants (e.g. musl vs gnu libc builds).
# KEYWORD=musl
#
# When multiple .deb assets match and stdin is not a TTY, choose:
#   first | last | <1-indexed number>
# Ignored when a TTY is present — you'll get an interactive menu.
# MULTI_DEB_SELECTION=first

# ---------------------------------------------------------------------------
# Installer
# ---------------------------------------------------------------------------
# apt (default) or gdebi.
# INSTALLER=apt
#
# On install failure, attempt rollback to the previously installed version.
# Tries the rollback cache first, then falls back to apt repositories.
# AUTO_DOWNGRADE_ON_FAIL=true
#
# Number of previous versions to keep per package in the rollback cache.
# ROLLBACK_KEEP=1

# ---------------------------------------------------------------------------
# Checksums
# ---------------------------------------------------------------------------
# Fail if no SHA-256 can be extracted from the release. When false, log a
# warning and install anyway.
# REQUIRE_CHECKSUM=true

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# When false, always download; do not stage or reuse pending.
# USE_PENDING_CACHE=false
#
# Soft size warning threshold for the cache directory, in MB.
# CACHE_MAX_MB=500

# ---------------------------------------------------------------------------
# GitHub API
# ---------------------------------------------------------------------------
# Required for private repositories. Sent to asset downloads as well.
# GITHUB_TOKEN=ghp_...
#
# For GitHub Enterprise.
# GITHUB_API_BASE=https://github.example.com/api/v3

# ---------------------------------------------------------------------------
# Privilege escalation
# ---------------------------------------------------------------------------
# Empty SUDO disables escalation (only useful when running as root or in a
# container where the invoking user already has the required privileges).
# SUDO=sudo
# SUDO_OPTS=-n

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Rotate updater.log to .1 when it exceeds this size, at the start of the
# next run.
# LOG_MAX_BYTES=1048576
